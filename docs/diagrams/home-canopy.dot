localmcp -> nas [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
localmcp -> ha [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
localmcp -> cups [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
localmcp -> music [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
localmcp -> ssh [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
gateway -> boxmcp [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0", label="upstream over the tailnet"];
cfedge -> vpscfd [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100", label="its own hostnames"];
vpscfd -> vpsapps [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100"];
boxmcp -> vpsapps [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
gateway -> sitegw [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0", label="one upstream"];
sitegw -> sitetools [color="#7cb342", style="bold", penwidth="2.6", fontcolor="#33691e"];
{rank=source; legend}
}
