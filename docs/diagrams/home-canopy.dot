digraph G {
rankdir=LR; compound=true; newrank=true; nodesep=0.25; ranksep=0.6; splines=true; pad=0.1; bgcolor=transparent;
fontname="Atkinson Hyperlegible";
node [shape=box, fontname="Atkinson Hyperlegible", fontsize=20, color="#37474f", margin="0.12,0.07"];
edge [fontname="Atkinson Hyperlegible", fontsize=16, arrowsize=0.8];
legend [shape=plaintext, fontsize=18, label=<<TABLE BORDER="1" COLOR="#90a4ae" CELLBORDER="0" CELLSPACING="3" CELLPADDING="3"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Key</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1b5e20"><B>———</B></FONT></TD><TD ALIGN="LEFT">MCP over HTTP, with a token</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1565c0"><B>———</B></FONT></TD><TD ALIGN="LEFT">Tailscale (WireGuard)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#e65100"><B>———</B></FONT></TD><TD ALIGN="LEFT">Cloudflare: OAuth, Access, tunnel</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a1b9a"><B>- - - -</B></FONT></TD><TD ALIGN="LEFT">OpenAI tunnel</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7cb342"><B>———</B></FONT></TD><TD ALIGN="LEFT">Local network: API or SSH</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#37474f"><B>———</B></FONT></TD><TD ALIGN="LEFT">Outbound HTTPS</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#607d8b"><B>———</B></FONT></TD><TD ALIGN="LEFT">Internal: control API, database</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#00838f"><B>———</B></FONT></TD><TD ALIGN="LEFT">Files: S3 and presigned URLs</TD></TR><TR><TD ALIGN="LEFT">Dashed box</TD><TD ALIGN="LEFT">Opt-in compose profile, or optional</TD></TR></TABLE>>];
subgraph cluster_own { label=<<B>Your own devices</B>>; labeljust=l; style="rounded,filled"; fillcolor="#fafafa"; color="#78909c"; fontsize=23;
cc [label=<<B>Claude Code</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">canopy-connector plugin:<br/>one connection, find, test, /skill</FONT>>, style="rounded,filled", fillcolor="white"];
pick [label=<<B>canopy-pick</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">terminal skill picker</FONT>>, style="rounded,filled", fillcolor="white"];
webui [label=<<B>Open WebUI, LibreChat</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">self-run clients, bearer token</FONT>>, style="rounded,filled", fillcolor="white"];
}
subgraph cluster_hosted { label=<<B>Hosted clients</B>>; labeljust=l; style="rounded,filled"; fillcolor="#fafafa"; color="#78909c"; fontsize=23;
claudeai [label=<<B>claude.ai</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">custom connector</FONT>>, style="rounded,filled", fillcolor="white"];
chatgpt [label=<<B>ChatGPT</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">app or plugin</FONT>>, style="rounded,filled", fillcolor="white"];
}
scripts [label=<<B>Scripts and agents elsewhere</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">can send CF-Access headers</FONT>>, style="rounded,filled", fillcolor="white"];
subgraph cluster_cf { label=<<B>Cloudflare</B>>; labeljust=l; style="rounded,filled"; fillcolor="#fff3e0"; color="#78909c"; fontsize=23;
portal [label=<<B><FONT POINT-SIZE="26">MCP server portal</FONT></B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">OAuth 2.1 + PKCE, per person</FONT>>, style="rounded,filled", fillcolor="white"];
access [label=<<B>Access</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">service tokens</FONT>>, style="rounded,filled", fillcolor="white"];
cfedge [label=<<B>Tunnel edge</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">private route to the gateway</FONT>>, style="rounded,filled", fillcolor="white"];
}
subgraph cluster_tailnet { label=<<B>Tailnet</B>>; labeljust=l; style="rounded,filled"; fillcolor="#e3f2fd"; color="#78909c"; fontsize=23;
mesh [label=<<B><FONT POINT-SIZE="26">Tailscale mesh</FONT></B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">members only, nothing public</FONT>>, style="rounded,filled", fillcolor="white"];
}
subgraph cluster_home { label=<<B>Home network</B>>; labeljust=l; style="rounded,filled"; fillcolor="#e8f5e9"; color="#78909c"; fontsize=23;
subgraph cluster_server { label=<<B>Home server: Docker host</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f8e9"; color="#78909c"; fontsize=23;
subgraph cluster_stack { label=<<B>Canopy stack</B>>; labeljust=l; style="rounded,filled"; fillcolor="#dcedc8"; color="#78909c"; fontsize=23;
gateway [label=<<B><FONT POINT-SIZE="26">gateway</FONT></B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">MCPJungle :8080<br/>/v0/groups/core/mcp<br/>/v0/groups/hosted/mcp</FONT>>, style="rounded,filled", fillcolor="#aed581"];
catalogue [label=<<B><FONT POINT-SIZE="26">catalogue</FONT></B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">skills index, BM25 + vectors</FONT>>, style="rounded,filled", fillcolor="white"];
toolbox [label=<<B><FONT POINT-SIZE="26">toolbox</FONT></B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">long-tail tools on demand</FONT>>, style="rounded,filled", fillcolor="white"];
api [label=<<B>api</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">control API :8090<br/>scheduler, backup, staging</FONT>>, style="rounded,filled", fillcolor="white"];
db [label=<<B>db</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">Postgres + pgvector</FONT>>, style="rounded,filled", fillcolor="white"];
seed [label=<<B>seed</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">one-shot, applies config</FONT>>, style="rounded,filled", fillcolor="white"];
cli [label=<<B>cli</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">gh, aws, rclone, restic<br/>logins stay here</FONT>>, style="rounded,filled", fillcolor="white"];
ui [label=<<B>ui</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">web picker :8081<br/>profile: ui</FONT>>, style="rounded,filled,dashed", fillcolor="white"];
storage [label=<<B><FONT POINT-SIZE="26">storage</FONT></B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">Garage S3 :3900, 1-day expiry<br/>profile: storage</FONT>>, style="rounded,filled,dashed", fillcolor="white"];
ollama [label=<<B>ollama</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">bge-m3 embeddings<br/>profile: search</FONT>>, style="rounded,filled,dashed", fillcolor="white"];
cfd [label=<<B>tunnel</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">cloudflared, dials out<br/>profile: tunnel</FONT>>, style="rounded,filled,dashed", fillcolor="white"];
tsc [label=<<B>tailnet</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">Tailscale sidecar<br/>profile: tailnet</FONT>>, style="rounded,filled,dashed", fillcolor="white"];
}
oaitc [label=<<B>tunnel-client</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">OpenAI, dials out, optional</FONT>>, style="rounded,filled,dashed", fillcolor="white"];
oper [label=<<B>Operator</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">canopy CLI on the host</FONT>>, style="rounded,filled", fillcolor="white"];
localmcp [label=<<B>Local MCP servers</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">your upstreams</FONT>>, style="rounded,filled", fillcolor="white"];
}
subgraph cluster_lan { label=<<B>Local tools</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f8e9"; color="#78909c"; fontsize=23;
opn [label=<<B>OPNsense</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">firewall and router</FONT>>, style="rounded,filled", fillcolor="white"];
nas [label=<<B>Synology NAS</B>>, style="rounded,filled", fillcolor="white"];
ha [label=<<B>Home Assistant</B>>, style="rounded,filled", fillcolor="white"];
cups [label=<<B>CUPS printers</B>>, style="rounded,filled", fillcolor="white"];
music [label=<<B>Music Assistant</B>>, style="rounded,filled", fillcolor="white"];
ssh [label=<<B>Local machines</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">SSH</FONT>>, style="rounded,filled", fillcolor="white"];
}
}
subgraph cluster_vps { label=<<B>Cloud VPS: just another remote</B>>; labeljust=l; style="rounded,filled"; fillcolor="#e1f5fe"; color="#78909c"; fontsize=23;
boxmcp [label=<<B>Box ops MCP server</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">joined to the tailnet</FONT>>, style="rounded,filled", fillcolor="white"];
vpsapps [label=<<B>Its own services</B>>, style="rounded,filled", fillcolor="white"];
vpscfd [label=<<B>cloudflared</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">its own tunnel, not the home one</FONT>>, style="rounded,filled", fillcolor="white"];
}
subgraph cluster_site { label=<<B>Remote site, optional</B>>; labeljust=l; style="rounded,filled,dashed"; fillcolor="#e8f5e9"; color="#78909c"; fontsize=23;
sitegw [label=<<B>Site gateway</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">one upstream, works alone on its LAN</FONT>>, style="rounded,filled", fillcolor="white"];
sitetools [label=<<B>Site tools</B>>, style="rounded,filled", fillcolor="white"];
}
subgraph cluster_cloud { label=<<B>Cloud services</B>>; labeljust=l; style="rounded,filled"; fillcolor="#e1f5fe"; color="#78909c"; fontsize=23;
git [label=<<B>Plugin marketplaces</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">git repos, cloned and indexed</FONT>>, style="rounded,filled", fillcolor="white"];
apis [label=<<B>Cloud APIs</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">Gemini, image and video models</FONT>>, style="rounded,filled", fillcolor="white"];
saas [label=<<B>Hosted MCP servers</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">SaaS upstreams</FONT>>, style="rounded,filled", fillcolor="white"];
embed [label=<<B>Embeddings and rerank</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">hosted fallback, optional</FONT>>, style="rounded,filled", fillcolor="white"];
s3 [label=<<B>Off-site S3</B><BR/><FONT POINT-SIZE="16" COLOR="#1c2b33">restic backups</FONT>>, style="rounded,filled", fillcolor="white"];
}
gateway -> catalogue [color="#1b5e20", style="solid", penwidth="1.8", fontcolor="#1b5e20", label="core group"];
gateway -> toolbox [color="#1b5e20", style="solid", penwidth="1.8", fontcolor="#1b5e20", label="core group"];
toolbox -> gateway [color="#1b5e20", style="solid", penwidth="1.8", fontcolor="#1b5e20", constraint="false", label="calls upstreams"];
gateway -> ui [color="#1b5e20", style="solid", penwidth="1.8", fontcolor="#1b5e20", dir="back"];
seed -> api [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f"];
api -> gateway [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f", constraint="false", label="admin REST"];
api -> db [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f"];
catalogue -> db [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f", constraint="false"];
gateway -> db [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f", constraint="false"];
catalogue -> api [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f", constraint="false", label="embeddings"];
api -> ollama [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f"];
cfd -> gateway [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100"];
tsc -> gateway [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0"];
cc -> mesh [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0"];
pick -> mesh [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0"];
webui -> mesh [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0"];
mesh -> tsc [color="#1565c0", style="solid", penwidth="1.8", fontcolor="#1565c0", label="MCP inside the tailnet"];
claudeai -> portal [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100", label="OAuth"];
chatgpt -> portal [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100", label="OAuth"];
scripts -> access [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100", label="service token"];
portal -> cfedge [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100", label="hosted group"];
access -> cfedge [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100"];
cfedge -> cfd [color="#e65100", style="solid", penwidth="1.8", fontcolor="#e65100", label="tunnel"];
chatgpt -> oaitc [color="#6a1b9a", style="dashed", penwidth="1.5", fontcolor="#6a1b9a", label="retired in the source deployment"];
oaitc -> gateway [color="#6a1b9a", style="dashed", penwidth="1.5", fontcolor="#6a1b9a", label="hosted group"];
catalogue -> git [color="#37474f", style="solid", penwidth="1.2", fontcolor="#37474f", label="clone"];
catalogue -> embed [color="#37474f", style="solid", penwidth="1.2", fontcolor="#37474f", label="rerank"];
api -> embed [color="#37474f", style="solid", penwidth="1.2", fontcolor="#37474f", label="embed"];
gateway -> saas [color="#1b5e20", style="solid", penwidth="1.8", fontcolor="#1b5e20"];
localmcp -> apis [color="#37474f", style="solid", penwidth="1.2", fontcolor="#37474f", label="tools call out"];
cli -> apis [color="#37474f", style="solid", penwidth="1.2", fontcolor="#37474f"];
api -> s3 [color="#37474f", style="solid", penwidth="1.2", fontcolor="#37474f", label="restic"];
mesh -> api [color="#00838f", style="solid", penwidth="1.6", fontcolor="#00838f", label="stage a file: needs the API token"];
api -> storage [color="#00838f", style="solid", penwidth="1.6", fontcolor="#00838f", label="stage"];
storage -> localmcp [color="#00838f", style="solid", penwidth="1.6", fontcolor="#00838f", constraint="false", label="tool fetches by presigned URL"];
oper -> api [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f", label="control API"];
oper -> cli [color="#607d8b", style="solid", penwidth="1.1", fontcolor="#37474f", label="canopy run"];
gateway -> localmcp [color="#1b5e20", style="solid", penwidth="1.8", fontcolor="#1b5e20", label="registered upstreams"];
