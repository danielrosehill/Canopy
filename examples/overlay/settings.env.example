# Copy to settings.env and commit it. Settings only: anything secret goes in secrets.env or env.sh.
# Later wins: settings.env, then secrets.env, then what env.sh prints. See .env.example in Canopy.
# These feed compose's ${VAR} substitution only; they are not put into any container's environment.
CANOPY_TAG=v1
CANOPY_CLIENT_NAME=canopy
CORE_GROUP=core
# EMBED_PROVIDER=openrouter
# EMBED_ON_SYNC=true
# For env.sh with Infisical: these name things, and are not secret.
# INFISICAL_CLIENT_ID=
# INFISICAL_PROJECT_ID=
