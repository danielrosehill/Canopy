#!/bin/sh
# Copy to env.sh, keep it executable, and commit it: it holds no values.
# canopy runs it in this folder before each `docker compose` call, with your environment plus
# settings.env and secrets.env. Print KEY=VALUE lines on stdout and nothing else (lines starting
# with # are fine). The values stay in memory and win over both files. Errors go to stderr.
# `canopy --no-hooks ...` skips it.
set -eu

# --- Infisical: a machine identity with universal auth ---
# INFISICAL_CLIENT_ID and INFISICAL_PROJECT_ID in settings.env. INFISICAL_CLIENT_SECRET stays on the
# machine: in your shell environment, or in secrets.env.
# INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id="$INFISICAL_CLIENT_ID" \
#   --client-secret="$INFISICAL_CLIENT_SECRET" --silent --plain)
# export INFISICAL_TOKEN
# infisical export --projectId="$INFISICAL_PROJECT_ID" --env=prod --format=dotenv

# --- 1Password: a service account ---
# OP_SERVICE_ACCOUNT_TOKEN stays on the machine. secrets.tpl is committed, and holds references:
#   MY_MCP_API_KEY={{ op://my-vault/my-mcp/credential }}
# op inject --in-file secrets.tpl

# Delete this line once one of the above is in use.
echo "# env.sh: no secrets manager configured yet"
