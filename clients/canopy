#!/usr/bin/env python3
"""The Canopy command line. Python standard library only.

    canopy [--no-hooks] COMMAND ...  --no-hooks skips env.sh, as CANOPY_NO_HOOKS=1 does
    canopy init                     make the folders and default config
    canopy up [compose args]        start the stack and wait for the seed
    canopy down [compose args]      stop it. Data stays in the folders
    canopy update [--no-backup]     back up, move to the newest release of CANOPY_TAG, and go back if unhealthy
    canopy status                   health of every component
    canopy servers | groups | tools list what the gateway has
    canopy add-server FILE [--replace]    FILE is JSON, or - for stdin
    canopy remove-server NAME
    canopy set-group FILE
    canopy remove-group NAME
    canopy validate                 what is wrong with the config, changing nothing
    canopy diff                     what `apply` would do now
    canopy apply                    apply agent-data/config to the gateway
    canopy enable | disable NAME    put an upstream in or out of service, keeping it registered
    canopy enable-tool | disable-tool NAME
    canopy refresh NAME             re-read an upstream's tools
    canopy marketplaces             the marketplaces in the config
    canopy add-marketplace REPO [NAME]    owner/name or an https URL, then a sync
    canopy remove-marketplace NAME
    canopy sync [PLUGIN] [--full] [--force] [--gateway]    start a sync. Alone: only what moved.
                                    --gateway: the gateway's servers and tools instead
    canopy embed [--run]            what is pending and its cost. --run starts it
    canopy read ID                  one record in full, such as skill:my-plugin/my-skill
    canopy jobs                     the scheduler's jobs and their last runs
    canopy jobs run NAME            run a job now
    canopy jobs runs NAME           recent runs of a job
    canopy token                    print the agent token for MCP clients
    canopy stage FILE [--audience remote|stack] [--bucket NAME] [--expires SECONDS]
                                    upload to staging, and print a presigned URL
    canopy buckets                  the staging buckets and their use
    canopy api METHOD PATH [JSON]   call any route
    canopy run CMD [ARGS...]        run a command in the cli container
    canopy clis ACTION [NAME...]    tools in the cli container: list, choose, add, remove, install, logins, check, all
    canopy compose [ARGS...]        docker compose, with Canopy's files
    canopy overlay pull | status    the managed clone of CANOPY_OVERLAY
    canopy backup                   start a backup now, and wait for it
    canopy backups                  the snapshots at the target
    canopy backup-plan              what a restore would bring back and overwrite
    canopy restore [--replace]      bring back the latest backup, stopping the stack to do it

    CANOPY_AGENT_DATA   default ~/canopy/agent-data
    CANOPY_OVERLAY      a git URL. Its clone, in $CANOPY_DATA/overlay, replaces CANOPY_AGENT_DATA
    CANOPY_OVERLAY_REF  a branch, tag or commit of it. Default: the remote's default branch
    CANOPY_DATA         default ~/canopy/data
    CANOPY_API_URL      default http://127.0.0.1:8090
    CANOPY_API_TOKEN    default: read from $CANOPY_DATA/api/token
"""
from __future__ import annotations

import base64
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import NamedTuple

REPO = Path(__file__).resolve().parent.parent
IN_CLI = os.environ.get("CANOPY_IN_CLI") == "1"
AGENT_FOLDERS = ("config", "skills", "notes", "cli")
BACKUP_WAIT = 4 * 3600   # as BACKUP_TIMEOUT_SEC
DATA_FOLDERS = ("api", "admin", "tokens", "postgres", "catalogue", "backups", "storage", "storage-secrets")
CONFIG_EDITS = ("add-server", "remove-server", "set-group", "remove-group", "add-marketplace", "remove-marketplace")
KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
NOTICES: dict[str, bool] = {}   # each printed once


def read_env_file(path: Path) -> dict[str, str]:
    out = {}
    if path.is_file():
        for line in path.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip().removeprefix("export ").strip()] = v.strip().strip("'\"")
    return out


BOOTSTRAP = ("CANOPY_OVERLAY", "CANOPY_OVERLAY_REF", "CANOPY_DATA", "CANOPY_AGENT_DATA")


def setting(name: str, default: str) -> str:
    """The process environment wins, then the checkout's .env, then settings.env in the overlay (or agent
    data). So `canopy` itself sees what compose sees, such as CANOPY_API_PORT, without a wrapper exporting
    it. The names that locate those folders come only from the first two."""
    found = os.environ.get(name) or read_env_file(REPO / ".env").get(name)
    if found or name in BOOTSTRAP:
        return found or default
    return own_settings().get(name) or default


def own_settings() -> dict[str, str]:
    """settings.env from the overlay clone when CANOPY_OVERLAY is set, else from CANOPY_AGENT_DATA."""
    def boot(n: str, d: str) -> str:
        return os.environ.get(n) or read_env_file(REPO / ".env").get(n) or d
    home = Path.home()
    if boot("CANOPY_OVERLAY", ""):
        folder = Path(boot("CANOPY_DATA", str(home / "canopy/data"))).expanduser() / "overlay"
    else:
        folder = Path(boot("CANOPY_AGENT_DATA", str(home / "canopy/agent-data"))).expanduser()
    return read_env_file(folder / "settings.env")


def folders() -> tuple[Path, Path]:
    home = Path.home()
    return (Path(setting("CANOPY_AGENT_DATA", str(home / "canopy/agent-data"))).expanduser(),
            Path(setting("CANOPY_DATA", str(home / "canopy/data"))).expanduser())


class Place(NamedTuple):
    """Where each kind of thing lives. Without an overlay, `source` and `state` are both CANOPY_AGENT_DATA."""
    source: Path   # read: config/, compose.override.yaml, settings.env, env.sh, skills/, notes/
    state: Path    # written: secrets.env, and cli/ for CLI logins. Never in the overlay's git
    data: Path     # Canopy's
    overlay: str   # CANOPY_OVERLAY, or ""


def places() -> Place:
    agent, data = folders()
    url = setting("CANOPY_OVERLAY", "")
    if not url:
        return Place(agent, agent, data, "")
    if setting("CANOPY_AGENT_DATA", "") and not NOTICES.get("both"):
        NOTICES["both"] = True
        print(f"CANOPY_OVERLAY is set, so {agent} (CANOPY_AGENT_DATA) is not used", file=sys.stderr)
    return Place(data / "overlay", data / "agent-state", data, url)


# --- the overlay: a managed clone of a git repo -------------------------------------------

def shown_url(url: str) -> str:
    """A URL with any user or password in it masked."""
    return re.sub(r"//[^/@]+@", "//***@", url)


def overlay_git_env(p: Place) -> dict[str, str]:
    """GITHUB_TOKEN reaches git for https://github.com/ only, through the environment of that one
    call: never in its arguments, and never in the clone's .git/config."""
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    token = os.environ.get("GITHUB_TOKEN") or read_env_file(p.state / "secrets.env").get("GITHUB_TOKEN")
    if token and p.overlay.startswith("https://github.com/"):
        n = int(env.get("GIT_CONFIG_COUNT") or 0)
        basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
        env.update({"GIT_CONFIG_COUNT": str(n + 1), f"GIT_CONFIG_KEY_{n}": "http.https://github.com/.extraHeader",
                    f"GIT_CONFIG_VALUE_{n}": f"Authorization: Basic {basic}"})
    return env


def overlay_git(p: Place, *args: str, check: bool = True, env: dict | None = None) -> subprocess.CompletedProcess:
    done = subprocess.run(["git", "-C", str(p.source), *args], env=env or {**os.environ, "GIT_TERMINAL_PROMPT": "0"},
                          capture_output=True, text=True)
    if check and done.returncode:
        sys.exit(f"overlay: git {args[0]} failed, so nothing was changed: {done.stderr.strip()}")
    return done


def overlay_sync() -> Place:
    """Clone CANOPY_OVERLAY, or fetch it, and check out CANOPY_OVERLAY_REF. A clone with local changes
    is not touched: the overlay repo is where changes go."""
    p = places()
    if not p.overlay or IN_CLI:
        return p
    clone, ref, env = p.source, setting("CANOPY_OVERLAY_REF", ""), overlay_git_env(p)
    if not (clone / ".git").exists():
        if clone.exists() and any(clone.iterdir()):
            sys.exit(f"{clone} is not a git clone. Move it away, and canopy clones CANOPY_OVERLAY there.")
        clone.parent.mkdir(parents=True, exist_ok=True)
        done = subprocess.run(["git", "clone", "-q", p.overlay, str(clone)], env=env, capture_output=True, text=True)
        if done.returncode:
            sys.exit(f"cannot clone {shown_url(p.overlay)}: {done.stderr.strip()}\n"
                     "See \"Overlay by git URL\" in docs/customising.md for access to a private repo.")
        before = ""
    else:
        if overlay_git(p, "status", "--porcelain").stdout.strip():
            sys.exit(f"{clone} has local changes, so it was not touched. It is a managed clone of "
                     "CANOPY_OVERLAY: commit the change to the overlay repo instead, and delete the folder "
                     "to clone it afresh.")
        if overlay_git(p, "remote", "get-url", "origin").stdout.strip() != p.overlay:
            overlay_git(p, "remote", "set-url", "origin", p.overlay)
        before = overlay_git(p, "rev-parse", "HEAD", check=False).stdout.strip()
        overlay_git(p, "fetch", "-q", "--prune", "--tags", "--force", "origin", env=env)
    if not ref:
        overlay_git(p, "remote", "set-head", "origin", "--auto", env=env)
        ref = overlay_git(p, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").stdout.strip()
        ref = ref.removeprefix("origin/")

    def found(name: str) -> str:
        return overlay_git(p, "rev-parse", "--verify", "-q", name, check=False).stdout.strip()

    if found(f"refs/remotes/origin/{ref}"):
        if found(f"refs/heads/{ref}"):
            ahead = overlay_git(p, "rev-list", "--count", f"refs/remotes/origin/{ref}..refs/heads/{ref}").stdout
            if int(ahead.strip() or 0):
                sys.exit(f"{clone} has commits that are not on the remote, so it was not touched. "
                         "Push them to the overlay repo, and delete the folder to clone it afresh.")
        overlay_git(p, "checkout", "-q", "--no-track", "-B", ref, f"refs/remotes/origin/{ref}")
    else:
        commit = found(f"refs/tags/{ref}^{{commit}}") or found(f"{ref}^{{commit}}")
        if not commit:
            overlay_git(p, "fetch", "-q", "origin", ref, check=False, env=env)   # a commit no branch has
            commit = found(f"{ref}^{{commit}}")
        if not commit:
            sys.exit(f"CANOPY_OVERLAY_REF={ref} is no branch, tag or commit of {shown_url(p.overlay)}")
        overlay_git(p, "checkout", "-q", "--detach", commit)
    after = overlay_git(p, "rev-parse", "HEAD").stdout.strip()
    if after != before:
        print(f"overlay: {ref} at {after[:12]}", file=sys.stderr)
    # The cli container mounts its home over /agent-data/cli, and cannot make that folder in a read-only
    # mount. An empty folder is invisible to git.
    (clone / "cli").mkdir(exist_ok=True)
    (p.state / "cli").mkdir(parents=True, exist_ok=True)
    return p


def overlay_status() -> int:
    p = places()
    if not p.overlay:
        sys.exit("CANOPY_OVERLAY is not set")
    print(f"url:    {shown_url(p.overlay)}")
    print(f"ref:    {setting('CANOPY_OVERLAY_REF', '') or '(the remote default branch)'}")
    if not (p.source / ".git").exists():
        print(f"clone:  none yet at {p.source}. `canopy overlay pull` makes it")
        return 0
    print(f"clone:  {p.source}")
    print(f"commit: {overlay_git(p, 'log', '-1', '--format=%h %s').stdout.strip()}")
    dirty = overlay_git(p, "status", "--porcelain").stdout.strip()
    print(f"state:  {'LOCAL CHANGES: the next pull refuses' if dirty else 'clean'}")
    branch = overlay_git(p, "symbolic-ref", "-q", "--short", "HEAD", check=False).stdout.strip()
    counts = overlay_git(p, "rev-list", "--left-right", "--count", f"refs/remotes/origin/{branch}...HEAD",
                         check=False).stdout.split() if branch else []
    if len(counts) == 2:
        print(f"remote: {counts[0]} behind, {counts[1]} ahead of origin/{branch}, as of the last fetch")
    return 1 if dirty else 0


# --- settings.env, secrets.env and the env.sh hook ----------------------------------------

def parse_hook_output(text: str) -> dict[str, str]:
    """KEY=VALUE lines. A bad line is named by its number only: its value may be a secret."""
    out = {}
    for n, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, eq, value = line.removeprefix("export ").lstrip().partition("=")
        if not eq or not KEY.fullmatch(key):
            sys.exit(f"env.sh: line {n} of its output is not KEY=VALUE, so canopy stopped")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        out[key] = value
    return out


HOOK_RUNS: dict[Path, dict[str, str]] = {}   # by hook path: a secrets manager is asked once per process


def hook_env() -> dict[str, str]:
    """What an executable env.sh prints. Its values are held in memory only, and never printed."""
    p = places()
    hook = p.source / "env.sh"
    if os.environ.get("CANOPY_NO_HOOKS") == "1" or IN_CLI or not hook.is_file():
        return {}
    if hook not in HOOK_RUNS:
        HOOK_RUNS[hook] = run_hook(p, hook)
    return HOOK_RUNS[hook]


def run_hook(p: Place, hook: Path) -> dict[str, str]:
    if not os.access(hook, os.X_OK):
        print(f"{hook} is not executable, so it was skipped", file=sys.stderr)
        return {}
    env = {**read_env_file(p.source / "settings.env"), **read_env_file(p.state / "secrets.env"), **os.environ}
    done = subprocess.run([str(hook)], cwd=p.source, env=env, capture_output=True, text=True)
    sys.stderr.write(done.stderr)
    if done.returncode:
        print(f"{hook} failed with exit code {done.returncode}, so canopy stopped", file=sys.stderr)
        raise SystemExit(done.returncode)
    return parse_hook_output(done.stdout)


def hook_compose_file(p: Place, names: list[str]) -> Path:
    """Names only, never values: compose passes each into `api` and `cli` from its own environment,
    as `env_file` does for secrets.env. JSON is YAML."""
    path = p.data / "agent-state" / "hook-env.yaml"
    text = json.dumps({"services": {s: {"environment": sorted(names)} for s in ("api", "cli")}}, indent=1) + "\n"
    if not path.is_file() or path.read_text() != text:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
    return path


def make_data_folders(data: Path) -> None:
    for f in DATA_FOLDERS:
        (data / f).mkdir(parents=True, exist_ok=True)
    for f in ("api", "admin", "tokens", "storage-secrets"):
        (data / f).chmod(0o700)


def init() -> int:
    p = overlay_sync()
    if p.overlay:   # nothing is copied into the clone: the overlay repo holds the config
        make_data_folders(p.data)
        print(f"overlay:    {shown_url(p.overlay)}\nclone:      {p.source}\nstate:      {p.state}\n"
              f"data:       {p.data}")
        return 0
    agent, data = folders()
    for f in AGENT_FOLDERS:
        (agent / f).mkdir(parents=True, exist_ok=True)
    make_data_folders(data)
    for f in ("marketplaces.json", "servers.json"):
        if not (agent / "config" / f).exists():
            shutil.copy(REPO / "config" / f, agent / "config" / f)
    secrets = agent / "secrets.env"
    if not secrets.exists():
        shutil.copy(REPO / ".env.example", secrets)
        secrets.chmod(0o600)
    print(f"agent data: {agent}\ndata:       {data}\nsettings:   {secrets}")
    return 0


def compose_args() -> list[str]:
    """Later env files win: settings.env, then secrets.env. env.sh's values win over both, as the
    environment compose runs in."""
    p = places()
    args = ["docker", "compose", "--project-directory", str(REPO)]
    for env_file in (REPO / ".env", p.source / "settings.env", p.state / "secrets.env"):
        if env_file.is_file():
            args += ["--env-file", str(env_file)]
    args += ["-f", str(REPO / "compose.yaml")]
    if p.overlay:
        args += ["-f", str(REPO / "compose.overlay.yaml")]
    override = p.source / "compose.override.yaml"
    if override.is_file():
        args += ["-f", str(override)]
    names = list(hook_env())
    if names:
        args += ["-f", str(hook_compose_file(p, names))]
    return args


def compose_env() -> dict[str, str]:
    p = places()
    return {**os.environ, **hook_env(), "CANOPY_AGENT_DATA": str(p.source), "CANOPY_AGENT_STATE": str(p.state),
            "CANOPY_DATA": str(p.data), "CANOPY_UID": str(os.getuid()), "CANOPY_GID": str(os.getgid())}


def compose(*args: str) -> int:
    return subprocess.call([*compose_args(), *args], env=compose_env())


def up(args: list[str]) -> int:
    p = overlay_sync()
    if p.overlay:
        if not (p.source / "config").is_dir():
            sys.exit(f"the overlay has no config/ folder: {shown_url(p.overlay)}")
        if not (p.data / "api").is_dir():
            make_data_folders(p.data)
    elif not (p.source / "config").is_dir():
        init()
    code = compose("up", "-d", *args)
    if code:
        return code
    print("waiting for the seed...", flush=True)
    return compose("logs", "--follow", "--no-log-prefix", "seed") or seed_exit_code()


def capture(*cmd: str) -> str:
    """What a command printed, or nothing if it failed."""
    done = subprocess.run(cmd, env=compose_env(), capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ""


def git(*args: str) -> int:
    return subprocess.call(["git", "-C", str(REPO), *args])


def canopy_images() -> dict[str, str]:
    """Canopy's own images, by name, with the id each name has here now."""
    names = capture(*compose_args(), "config", "--images").split()
    return {n: capture("docker", "image", "inspect", "--format", "{{.Id}}", n)
            for n in names if re.search(r"(^|/)canopy:", n)}   # either registry


def release_ref(tag: str) -> str:
    """The commit of this repo that matches an image tag, so compose.yaml and the images agree."""
    if tag == "main":
        return "origin/main"
    if re.fullmatch(r"v\d+", tag):   # moves with each release: its newest
        tags = capture("git", "-C", str(REPO), "tag", "--list", f"{tag}.*", "--sort=-v:refname").split()
        if not tags:
            sys.exit(f"no release matches {tag}. Nothing was changed.")
        return tags[0]
    return tag


def healthy(tries: int = 60, wait: float = 5) -> bool:
    for attempt in range(tries):
        try:
            code, reply = call("GET", "/v1/status", timeout=10)
            if code < 400 and reply.get("ok"):
                return True
        except (SystemExit, OSError, ValueError):   # not up yet
            pass
        if attempt < tries - 1:
            time.sleep(wait)
    return False


def backup_now(wait: float = BACKUP_WAIT, poll: float = 5) -> bool | None:
    """True once a backup has finished, None with no target to back up to, False if it failed."""
    code, reply = call("GET", "/v1/backup/config", timeout=10)
    if code == 409:
        return None
    if code >= 400:
        print(f"cannot read the backup target: {reply.get('error', code)}", file=sys.stderr)
        return False

    def runs() -> list[dict]:
        code, reply = call("GET", "/v1/jobs/backup-data/runs", timeout=10)
        return reply if code < 400 else []

    seen = max((r["id"] for r in runs() if r["finished"]), default=0)   # a run in progress counts as new
    code, reply = call("POST", "/v1/backup", timeout=10)
    if code >= 400:
        print(f"cannot start a backup: {reply.get('error', code)}", file=sys.stderr)
        return False
    deadline = time.time() + wait
    while time.time() < deadline:
        done = [r for r in runs() if r["id"] > seen and r["finished"]]
        if done:
            if not done[0]["ok"]:
                print(f"the backup failed: {done[0]['output'][:500]}", file=sys.stderr)
            return bool(done[0]["ok"])
        time.sleep(poll)
    print(f"no backup finished within {wait:.0f} s", file=sys.stderr)
    return False


def update(args: list[str] | tuple = ()) -> int:
    """Pull first, so the only downtime is the swap, and go back if the new version is unhealthy.
    Going back restores the images and compose.yaml. It cannot undo a database migration, so a backup
    runs first, once there is a new version to move to. The backup of a stack that is down is skipped."""
    if IN_CLI:
        sys.exit("run `canopy update` on the host, not in the cli container")
    before = canopy_images()
    if not before:
        sys.exit("cannot read the stack's images: check `canopy compose config`")
    tag = next(n.rsplit(":", 1)[1] for n in before if ":cli-" not in n)
    was_healthy = healthy(tries=1)
    head = capture("git", "-C", str(REPO), "rev-parse", "HEAD") if (REPO / ".git").exists() else ""
    if head:
        if capture("git", "-C", str(REPO), "status", "--porcelain", "--untracked-files=no"):
            sys.exit(f"{REPO} has local changes, so nothing was changed. Your own changes belong in "
                     "the agent-data folder: see docs/customising.md.")
        if git("fetch", "-q", "--tags", "--force", "origin") or git("checkout", "-q", "--detach", release_ref(tag)):
            git("checkout", "-q", "--detach", head)
            sys.exit("cannot fetch the release, so the stack was not touched")
    if compose("pull", "--quiet", "api", "cli"):
        if head:
            git("checkout", "-q", "--detach", head)
        print("pull failed, so the stack was not touched", file=sys.stderr)
        return 1
    new_head = capture("git", "-C", str(REPO), "rev-parse", "HEAD") if head else ""
    if canopy_images() == before and new_head == head:
        print(f"already up to date on {tag}")
        return 0
    backed_up = None
    if "--no-backup" not in args and was_healthy:
        backed_up = backup_now()
        if backed_up is False:
            if head:
                git("checkout", "-q", "--detach", head)
            print("the stack was not touched. `canopy update --no-backup` goes ahead without one", file=sys.stderr)
            return 1
        print("backed up" if backed_up else "no backup target, so going ahead without a backup")
    if up([]) == 0 and healthy():
        print(f"updated on {tag}" + (f" at {new_head[:12]}" if new_head else ""))
        return 0
    if not was_healthy:
        print("not healthy after the update, and it was not healthy before: left as it is", file=sys.stderr)
        return 1
    print("not healthy after the update: going back", file=sys.stderr)
    for name, image in before.items():
        if image:
            subprocess.call(["docker", "tag", image, name])
    if head:
        git("checkout", "-q", "--detach", head)
    up([])
    print("went back to the previous version" if healthy() else "STILL NOT HEALTHY: see `canopy status`",
          file=sys.stderr)
    if backed_up:
        print("if the new version migrated the database, `canopy restore --replace` brings back the backup "
              "taken just now", file=sys.stderr)
    return 1


def seed_exit_code() -> int:
    out = subprocess.run([*compose_args(), "ps", "-a", "--format", "json", "seed"], env=compose_env(),
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        return int(json.loads(line).get("ExitCode", 1))
    return 1


def restore(args: list[str]) -> int:
    """Files first, so the database starts with the restored passwords. Then the databases."""
    tool = ["run", "--rm", "--no-deps", "-T", "api", "python", "-m", "canopy.backup"]

    def restore_files() -> int:
        p = places()
        if not p.overlay:
            return compose(*tool, "restore-files")
        # The overlay is mounted read-only, and git holds its config: the backed-up copy goes beside it.
        scratch = p.state / "restored"
        (scratch / "config").mkdir(parents=True, exist_ok=True)
        print(f"the backed-up agent data goes to {scratch}: your config comes from the overlay", file=sys.stderr)
        return subprocess.call([*compose_args(), *tool, "restore-files"],
                               env={**compose_env(), "CANOPY_AGENT_DATA": str(scratch), "CANOPY_OVERLAY_MOUNT": "rw"})

    return (compose("stop") or restore_files() or compose("up", "-d", "--wait", "db")
            or compose(*tool, "restore-db", *args) or up([]))


def run(args: list[str]) -> int:
    if not args:
        sys.exit("usage: canopy run CMD [ARGS...]")
    if IN_CLI:
        os.execvp(args[0], args)
    tty = [] if sys.stdin.isatty() and sys.stdout.isatty() else ["-T"]
    return compose("exec", *tty, "cli", *args)


def api_token() -> str:
    token = os.environ.get("CANOPY_API_TOKEN")
    if token:
        return token
    path = Path("/api/token") if IN_CLI else folders()[1] / "api" / "token"
    try:
        return path.read_text().strip()
    except OSError as e:
        sys.exit(f"cannot read the API token at {path}: {e.strerror}. Has the stack started?")


def api_url() -> str:
    default = "http://api:8090" if IN_CLI else f"http://127.0.0.1:{setting('CANOPY_API_PORT', '8090')}"
    return setting("CANOPY_API_URL", default).rstrip("/")


def call(method: str, path: str, body: object = None, timeout: float = 900) -> tuple[int, object]:
    raw = isinstance(body, bytes)
    data = body if raw else None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(api_url() + path, data=data, method=method, headers={
        "Authorization": f"Bearer {api_token()}",
        "Content-Type": "application/octet-stream" if raw else "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        text = e.read().decode(errors="replace")
        try:
            return e.code, json.loads(text)
        except ValueError:
            return e.code, {"error": text[:500]}
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach the API at {api_url()}: {e.reason}. Is the stack running?")


def show(method: str, path: str, body: object = None) -> int:
    status, reply = call(method, path, body)
    print(json.dumps(reply, indent=2, ensure_ascii=False))
    return 0 if status < 400 else 1


def stage(args: list[str]) -> int:
    file, query, flags = Path(args[0]), {"name": Path(args[0]).name}, args[1:]
    if len(flags) % 2 or any(f not in ("--audience", "--bucket", "--expires") for f in flags[::2]):
        sys.exit(f"unknown arguments: {' '.join(flags)}\n{__doc__}")
    query.update((f.removeprefix("--"), v) for f, v in zip(flags[::2], flags[1::2]))
    return show("POST", f"/v1/storage/stage?{urllib.parse.urlencode(query)}", file.read_bytes())


def status() -> int:
    code, reply = call("GET", "/v1/status")
    print(json.dumps(reply, indent=2, ensure_ascii=False))
    return 0 if code < 400 and reply.get("ok") else 1


def load_json(path: str) -> dict:
    return json.load(sys.stdin if path == "-" else open(path))


def main() -> int:
    argv = sys.argv[1:]
    if argv[:1] == ["--no-hooks"]:
        os.environ["CANOPY_NO_HOOKS"] = "1"
        argv = argv[1:]
    cmd, args = (argv[0], argv[1:]) if argv else ("help", [])
    if cmd in CONFIG_EDITS and not IN_CLI and places().overlay:
        sys.exit("CANOPY_OVERLAY is set, so the config is read-only here. Commit the change to the overlay "
                 "repo, then run `canopy apply`.")
    if cmd in ("help", "-h", "--help"):
        print(__doc__)
        return 0
    if cmd == "init":
        return init()
    if cmd == "up":
        return up(args)
    if cmd == "update":
        return update(args)
    if cmd == "down":
        return compose("down", *args)
    if cmd == "compose":
        overlay_sync()
        return compose(*args)
    if cmd == "overlay" and args == ["pull"]:
        p = overlay_sync()
        if not p.overlay:
            sys.exit("CANOPY_OVERLAY is not set")
        return overlay_status()
    if cmd == "overlay" and args == ["status"]:
        return overlay_status()
    if cmd == "clis":
        script = REPO / "plugins/canopy-manager/skills/manage-clis/scripts/clis.py"
        p = places()   # the choices are config, read from the source. Logins go to the state folder
        return subprocess.call([sys.executable, str(script), "--agent-data", str(p.state),
                                "--list", str(p.source / "config/cli.json"),
                                "--canopy", str(Path(__file__).resolve()), *args])
    if cmd == "run":
        return run(args)
    if cmd == "status":
        return status()
    if cmd in ("servers", "groups", "tools"):
        return show("GET", f"/v1/gateway/{cmd}")
    if cmd == "add-server" and args:
        replace = "?replace=true" if "--replace" in args else ""
        return show("POST", f"/v1/gateway/servers{replace}", load_json(args[0]))
    if cmd == "remove-server" and args:
        return show("DELETE", f"/v1/gateway/servers/{args[0]}")
    if cmd == "set-group" and args:
        doc = load_json(args[0])
        return show("PUT", f"/v1/gateway/groups/{doc['name']}", doc)
    if cmd == "remove-group" and args:
        return show("DELETE", f"/v1/gateway/groups/{args[0]}")
    if cmd == "jobs":
        if not args:
            return show("GET", "/v1/jobs")
        if args[0] == "run" and len(args) == 2:
            return show("POST", f"/v1/jobs/{args[1]}/run")
        if args[0] == "runs" and len(args) == 2:
            return show("GET", f"/v1/jobs/{args[1]}/runs")
    if cmd == "backup":
        done = backup_now()
        if done is None:
            sys.exit("no backup target: see the backup-restore skill")
        return 0 if done else 1
    if cmd == "backups":
        return show("GET", "/v1/backup")
    if cmd == "backup-plan":
        return show("GET", "/v1/backup/plan")
    if cmd == "restore":
        return restore(args)
    if cmd == "stage" and args:
        return stage(args)
    if cmd == "buckets":
        return show("GET", "/v1/storage/buckets")
    if cmd == "marketplaces":
        return show("GET", "/v1/catalogue/marketplaces")
    if cmd == "add-marketplace" and args:
        return show("POST", "/v1/catalogue/marketplaces",
                    {"repo": args[0], **({"name": args[1]} if len(args) > 1 else {})})
    if cmd == "remove-marketplace" and args:
        return show("DELETE", f"/v1/catalogue/marketplaces/{args[0]}")
    if cmd == "sync":
        flags = {f.removeprefix("--"): True for f in args if f in ("--full", "--force", "--gateway")}
        names = [a for a in args if not a.startswith("--")]
        return show("POST", "/v1/catalogue/sync", {**flags, **({"plugin": names[0]} if names else {})})
    if cmd == "embed":
        return show("POST", "/v1/embeddings/run") if "--run" in args else show("GET", "/v1/embeddings/pending")
    if cmd == "read" and args:
        code, reply = call("GET", f"/v1/catalogue/records/{urllib.parse.quote(args[0], safe=':/')}")
        print(reply.get("text") or json.dumps(reply, indent=2, ensure_ascii=False))
        return 0 if code < 400 else 1
    if cmd == "apply":
        overlay_sync()
        return show("POST", "/v1/config/apply")
    if cmd in ("validate", "diff"):
        code, reply = call("GET", f"/v1/config/{cmd}")
        print(json.dumps(reply, indent=2, ensure_ascii=False))
        return 0 if code < 400 and reply.get("ok") else 1
    if cmd in ("enable", "disable", "refresh") and args:
        return show("POST", f"/v1/gateway/servers/{args[0]}/{cmd}")
    if cmd in ("enable-tool", "disable-tool") and args:
        return show("POST", f"/v1/gateway/tools/{args[0]}/{cmd.split('-')[0]}")
    if cmd == "token":
        code, reply = call("GET", "/v1/tokens/agent")
        if code >= 400:
            sys.exit(reply.get("error", code))
        if reply["token"] is None:
            sys.exit("development mode: the gateway has no tokens")
        print(reply["token"])
        return 0
    if cmd == "api" and len(args) >= 2:
        return show(args[0].upper(), args[1], json.loads(args[2]) if len(args) > 2 else None)
    sys.exit(f"unknown command: {' '.join(argv)}\n{__doc__}")


if __name__ == "__main__":
    raise SystemExit(main())
