# `canopy init` copies this to agent-data/secrets.env, which holds both settings and secrets.
# Everything here is optional: the defaults give a working local stack.
# With plain `docker compose`, put these in .env in the checkout instead.

# --- Network ---
# Keep 127.0.0.1 unless something else protects the address. The gateway needs a token
# on every request in enterprise mode, but the web UI has no login of its own.
CANOPY_BIND=127.0.0.1
CANOPY_PORT=8080
CANOPY_UI_PORT=8081
# The control API. It needs a token on every request, in every mode.
# CANOPY_API_BIND=127.0.0.1
# CANOPY_API_PORT=8090
# Set this to choose the API token. Otherwise one is made in $CANOPY_DATA/api/token.
# CANOPY_API_TOKEN=
# Hostnames the web UI answers to, when it is reached by a name other than localhost.
# UI_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Content ---
# The two folders are set outside this file: as environment variables, or in .env in the
# checkout. Yours (config, skills, notes) and Canopy's (databases, tokens). Defaults:
#   CANOPY_AGENT_DATA=~/canopy/agent-data
#   CANOPY_DATA=~/canopy/data
# Needed only for private marketplaces and plugins.
# GITHUB_TOKEN=

# --- Gateway ---
# enterprise needs a bearer token on every request. development needs none, so use it
# only on a network you trust completely.
# SERVER_MODE=enterprise
# Read on the first start only: changing them later does not change the database.
# POSTGRES_PASSWORD=canopy
# GATEWAY_DB_PASSWORD=canopy
# CANOPY_DB_PASSWORD=canopy
# The -stdio image can run stdio upstreams through npx and uvx.
# MCPJUNGLE_TAG=0.4.7-stdio

# --- Search ---
# With no provider, search is keyword only and says so. Every embedding goes through the API.
# local needs the `search` profile (Ollama, about 2 GB of RAM):
#   COMPOSE_PROFILES=search
#   EMBED_PROVIDER=local
# Hosted costs cents for a whole index:
#   EMBED_PROVIDER=openrouter
#   OPENROUTER_API_KEY=...
# A second route, used if the first does not answer in time. It must serve the same model.
# EMBED_FALLBACK=local
# The canonical name, whichever route serves it. Stored vectors are 1024 dimensions.
# EMBED_MODEL=bge-m3
# Reranking moves the right skill to first place far more often, for about 4 cents per 1,000
# searches. Off by default: it sends the query and candidate descriptions to the provider.
# RERANK_MODEL=cohere/rerank-5-fast
# RERANK_API_KEY=...
# Embedding is a separate step, so a sync never spends money by surprise. Set this to
# true to embed new records on every sync instead.
# EMBED_ON_SYNC=false

# --- Naming ---
# The name your MCP client gives this server, as in mcp__<name>__<tool>.
# CANOPY_CLIENT_NAME=canopy
# The group agents connect to, and an optional group limiting catalogue and toolbox.
# CORE_GROUP=core
# TOOLS_GROUP=

# --- Profiles ---
# TUNNEL_TOKEN=            # tunnel
# TS_AUTHKEY=              # tailnet
# TS_HOSTNAME=canopy       # tailnet
# CANOPY_BACKUP_DIR=      # default $CANOPY_DATA/backups
